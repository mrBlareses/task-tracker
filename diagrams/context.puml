@startuml TaskTrackerArchitecture
!includeurl https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(user, "Пользователь", "Создает и управляет задачами через веб-интерфейс или мобильное приложение")

System_Ext(mailhog, "Mailhog (SMTP)", "SMTP сервер для dev среды")

System_Boundary(System_TaskTracker, "Task Tracker Microservice Platform") {

  Container(backend, "Backend Service", "Spring Boot, Spring Security, JWT, Spring Kafka", "REST API, бизнес-логика пользователей и задач. Генерирует email payload и публикует в Kafka")
  Container(cronService, "Cron Service", "Spring Boot, Spring Scheduler", "Планировщик задач. Триггерит Backend на генерацию ежедневной аналитики")
  Container(emailSender, "Email Sender Service", "Spring Boot, Spring Mail, Spring Kafka", "Потребляет готовые email payload из Kafka и отправляет письма через SMTP")

  ContainerDb(postgres, "PostgreSQL Database", "PostgreSQL 15", "Хранение пользователей, задач и системных данных")
  Container(kafka, "Kafka Message Broker", "Apache Kafka", "Асинхронная коммуникация. Топик EMAIL_SENDING_TASKS")
}

Rel(user, backend, "HTTP/REST API", "JWT")
Rel(backend, postgres, "JPA/Hibernate", "CRUD users/tasks")

Rel(cronService, backend, "HTTP/REST", "POST /api/v1/service/daily-analytics")

Rel(backend, kafka, "Kafka Producer", "Email payload (JSON)")
Rel(kafka, emailSender, "Kafka Consumer", "Email payload")

Rel(emailSender, mailhog, "SMTP", "Отправка писем")

SHOW_LEGEND()
@enduml