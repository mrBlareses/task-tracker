# ==========================
# SERVER
# ==========================
SERVER_PORT=8081

# ==========================
# POSTGRES
# ==========================
POSTGRES_DB=task_tracker_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ==========================
# SPRING DATASOURCE
# ==========================
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/task_tracker_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here

# ==========================
# KAFKA
# ==========================
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_BROKER_ID=1

SPRING_KAFKA_PRODUCER_ACKS=all
SPRING_KAFKA_PRODUCER_RETRIES=5
SPRING_KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
SPRING_KAFKA_PRODUCER_VALUE_SERIALIZER=org.springframework.kafka.support.serializer.JsonSerializer
SPRING_KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
SPRING_KAFKA_PRODUCER_MAX_IN_FLIGHT=5

SPRING_KAFKA_CONSUMER_GROUP_ID=email-sender-service

# ==========================
# APP KAFKA TOPICS
# ==========================
APP_KAFKA_TOPIC_DAILY_REPORT=daily-report
APP_KAFKA_TOPIC_USER_REGISTERED=user-registered

EMAIL_INGESTION_TOPIC_USER_REGISTERED=user-registered
EMAIL_INGESTION_TOPIC_DAILY_REPORT=daily-report
EMAIL_INGESTION_CONCURRENCY=1
EMAIL_INGESTION_RETRY_INTERVAL_MS=2000
EMAIL_INGESTION_RETRY_MAX_ATTEMPTS=3

# ==========================
# ZOOKEEPER
# ==========================
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# ==========================
# JWT
# ==========================
JWT_SECRET=your_jwt_secret_here

# ==========================
# AUTH (cron-service)
# ==========================
AUTH_BASE_URL=http://backend-service:8081
AUTH_LOGIN_ENDPOINT=/api/v1/auth/login
AUTH_EMAIL=service@local
AUTH_PASSWORD=service123

# ==========================
# CRON (daily analytics)
# ==========================
CRON_DAILY_ANALYTICS_EXPRESSION=0 */1 * * * *
CRON_DAILY_ANALYTICS_ZONE=UTC
CRON_DAILY_ANALYTICS_BACKEND_BASE_URL=http://backend-service:8081
CRON_DAILY_ANALYTICS_TRIGGER_PATH=/api/v1/service/daily-analytics/run
CRON_DAILY_ANALYTICS_STALE_THRESHOLD=PT15M

# ==========================
# RETRY (cron-service)
# ==========================
RETRY_DAILY_ANALYTICS_MAX_ATTEMPTS=3
RETRY_DAILY_ANALYTICS_FIRST_BACKOFF=1s
RETRY_DAILY_ANALYTICS_SECOND_BACKOFF=2s
RETRY_DAILY_ANALYTICS_THIRD_BACKOFF=5s

# ==========================
# EMAIL PROCESSING
# ==========================
EMAIL_PROCESSING_FIXED_DELAY_MS=5000
EMAIL_PROCESSING_BATCH_SIZE=50
EMAIL_PROCESSING_WORKER_THREADS=4
EMAIL_PROCESSING_RETRY_DELAY_MINUTES=5

# ==========================
# SMTP / MAIL
# ==========================
APP_MAIL_FROM=no-reply@task-tracker.local

SPRING_MAIL_HOST=mailhog
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

SPRING_MAIL_SMTP_AUTH=false
SPRING_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_SMTP_CONNECTION_TIMEOUT=5000
SPRING_MAIL_SMTP_TIMEOUT=5000
SPRING_MAIL_SMTP_WRITE_TIMEOUT=5000

# ==========================
# OPTIONAL JPA / DEBUG
# ==========================
SPRING_JPA_SHOW_SQL=false